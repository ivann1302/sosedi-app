generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AdminCapability {
  MODERATION
  SUPPORT
  KYC_REVIEW
  FINANCE
}

enum ItemStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum CategoryListingPolicy {
  ALLOWED
  RESTRICTED
  PROHIBITED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  RETURNED
  COMPLETED
  CANCELLED
}

enum BookingMessageAuthorRole {
  BORROWER
  LENDER
  SYSTEM
}

enum ReviewAuthorRole {
  BORROWER
  LENDER
}

enum BookingActStage {
  HANDOVER
  RETURN
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum KycDocumentType {
  PASSPORT
  SELFIE
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum SupportTicketType {
  GENERAL
  DISPUTE
}

enum BookingIssueReason {
  OWNER_NO_SHOW
  BORROWER_NO_SHOW
  ITEM_FAULTY
  EARLY_RETURN
  LATE_RETURN
  ITEM_DAMAGED
  ITEM_LOST
}

enum SupportMessageAuthorRole {
  USER
  SUPPORT
}

enum ReportTargetType {
  ITEM
  USER
  BOOKING
  MESSAGE
  REVIEW
}

enum ReportReason {
  PROHIBITED_CATEGORY
  MISLEADING_LISTING
  UNSAFE_ITEM
  SUSPECTED_FRAUD
  HARASSMENT
  IMPERSONATION
  PRIVACY_VIOLATION
  NO_SHOW
  UNSAFE_HANDOVER
  ITEM_NOT_AS_DESCRIBED
  OTHER
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum PushTokenProvider {
  FCM
  RUSTORE
}

enum PushPlatform {
  ANDROID
  IOS
}

enum PushDeliveryStatus {
  PENDING
  PROCESSING
  RETRY
  DELIVERED
}

model User {
  id                String            @id @default(uuid())
  phone             String            @unique
  name              String?
  city              String?
  avatarUrl         String?
  role              UserRole          @default(USER)
  adminCapabilities AdminCapability[] @default([])
  kycStatus         KycStatus?
  isBlocked         Boolean           @default(false)
  sessionVersion    Int               @default(0)
  deletedAt         DateTime?
  anonymizedAt      DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items                    Item[]                     @relation("ItemOwner")
  bookingsAsBorrower       Booking[]                  @relation("BookingBorrower")
  bookingsAsLender         Booking[]                  @relation("BookingLender")
  payments                 Payment[]
  kycDocuments             KycDocument[]              @relation("KycDocumentUser")
  reviewedKycDocuments     KycDocument[]              @relation("KycDocumentReviewer")
  supportTickets           SupportTicket[]            @relation("SupportTicketUser")
  assignedSupportTickets   SupportTicket[]            @relation("SupportTicketAssignee")
  respondedSupportTickets  SupportTicket[]            @relation("SupportTicketResponder")
  adminAuditLogs           AdminAuditLog[]            @relation("AdminAuditLogAdmin")
  adminMfaCredential       AdminMfaCredential?
  adminRecoveryCodes       AdminRecoveryCode[]
  uploadIntents            UploadIntent[]             @relation("UploadIntentActor")
  inboxEvents              InboxEvent[]
  notificationOutboxEvents NotificationOutboxEvent[]  @relation("NotificationRecipient")
  authoredBookingActs      BookingAct[]               @relation("BookingActAuthor")
  confirmedBookingActs     BookingAct[]               @relation("BookingActConfirmer")
  bookingTransitions       BookingTransitionHistory[]
  bookingMessages          BookingMessage[]            @relation("BookingMessageAuthor")
  reviewsAuthored          Review[]                    @relation("ReviewAuthor")
  reviewsReceived          Review[]                    @relation("ReviewTarget")
  reviewsModerated         Review[]                    @relation("ReviewModerator")
  supportMessages          SupportMessage[]
  reportsCreated           UserReport[]               @relation("ReportReporter")
  reportsReviewed          UserReport[]               @relation("ReportReviewer")
  blocksCreated            UserBlock[]                @relation("UserBlockBlocker")
  blocksReceived           UserBlock[]                @relation("UserBlockBlocked")
  devicePushTokens         DevicePushToken[]

  @@index([role])
  @@index([kycStatus])
  @@index([isBlocked])
  @@index([deletedAt, anonymizedAt])
  @@map("users")
}

model AdminMfaCredential {
  userId              String   @id
  totpSecretEncrypted String
  lastTotpStep        Int
  enabledAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_mfa_credentials")
}

model AdminRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("admin_recovery_codes")
}

model Category {
  id                   String                @id @default(uuid())
  name                 String                @unique
  slug                 String                @unique
  iconName             String?
  sortOrder            Int                   @default(0)
  isActive             Boolean               @default(true)
  isAllowedForListings Boolean               @default(false)
  listingPolicy        CategoryListingPolicy @default(RESTRICTED)
  safetyNotice         String                @default("Категория требует отдельной проверки перед публикацией.")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  items Item[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Item {
  id                           String                                @id @default(uuid())
  ownerId                      String
  clientRequestId              String?
  clientRequestHash            String?
  categoryId                   String
  title                        String
  description                  String
  condition                    ItemCondition
  completeness                 String
  handoverTerms                String
  pricePerDay                  Decimal                               @db.Decimal(10, 2)
  depositAmount                Decimal?                              @db.Decimal(10, 2)
  status                       ItemStatus                            @default(PENDING)
  rejectReason                 String?
  publicArea                   String
  address                      String
  latitude                     Float
  longitude                    Float
  location                     Unsupported("geography(Point,4326)")?
  listingRulesVersion          String?
  listingRulesAcceptedAt       DateTime?
  listingRulesAcceptanceMethod String?
  safetyNoticeSnapshot         String?
  createdAt                    DateTime                              @default(now())
  updatedAt                    DateTime                              @updatedAt

  owner              User                      @relation("ItemOwner", fields: [ownerId], references: [id])
  category           Category                  @relation(fields: [categoryId], references: [id])
  photos             ItemPhoto[]
  bookings           Booking[]
  unavailablePeriods ItemUnavailablePeriod[]
  outboxEvents       NotificationOutboxEvent[]
  inboxEvents        InboxEvent[]

  @@unique([ownerId, clientRequestId])
  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@index([pricePerDay])
  @@index([createdAt])
  @@index([location], type: Gist, map: "items_location_idx")
  @@map("items")
}

model ItemUnavailablePeriod {
  id        String   @id @default(uuid())
  itemId    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, startDate, endDate])
  @@index([itemId, startDate, endDate])
  @@map("item_unavailable_periods")
}

model ItemPhoto {
  id             String   @id @default(uuid())
  itemId         String
  uploadIntentId String?  @unique
  originalUrl    String?
  thumbnailUrl   String?
  previewUrl     String?
  sortOrder      Int      @default(0)
  isCover        Boolean  @default(false)
  createdAt      DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([itemId, sortOrder])
  @@map("item_photos")
}

model UploadIntent {
  id          String    @id @default(uuid())
  actorId     String
  purpose     String
  entityId    String
  bucket      String
  objectKey   String    @unique
  contentType String
  sizeBytes   Int
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  actor             User               @relation("UploadIntentActor", fields: [actorId], references: [id], onDelete: Cascade)
  bookingEvidence   BookingEvidence?
  supportAttachment SupportAttachment?

  @@index([actorId])
  @@index([entityId])
  @@index([expiresAt])
  @@map("upload_intents")
}

model Booking {
  id                 String        @id @default(uuid())
  itemId             String
  borrowerId         String
  clientRequestId    String?
  clientRequestHash  String?
  lenderId           String
  startDate          DateTime      @db.Date
  endDate            DateTime      @db.Date
  totalAmount        Decimal       @db.Decimal(10, 2)
  status             BookingStatus @default(PENDING)
  expiresAt          DateTime?
  cancellationReason String?
  termsSnapshot      Json?
  disputeOpenedAt    DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  item           Item                       @relation(fields: [itemId], references: [id])
  borrower       User                       @relation("BookingBorrower", fields: [borrowerId], references: [id])
  lender         User                       @relation("BookingLender", fields: [lenderId], references: [id])
  payment        Payment?
  supportTickets SupportTicket[]
  outboxEvents   NotificationOutboxEvent[]
  inboxEvents    InboxEvent[]
  acts           BookingAct[]
  transitions    BookingTransitionHistory[]
  messages       BookingMessage[]
  reviews        Review[]

  @@unique([borrowerId, clientRequestId])
  @@index([itemId])
  @@index([borrowerId])
  @@index([lenderId])
  @@index([status])
  @@index([expiresAt])
  @@index([startDate, endDate])
  @@map("bookings")
}

model BookingMessage {
  id              String                   @id @default(uuid())
  bookingId       String
  authorId        String?
  authorRole      BookingMessageAuthorRole
  clientMessageId String?
  body            String                   @db.VarChar(2000)
  createdAt       DateTime                 @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  author  User?   @relation("BookingMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([authorId, clientMessageId])
  @@index([bookingId, createdAt, id])
  @@index([authorId])
  @@map("booking_messages")
}

model Review {
  id             String           @id @default(uuid())
  bookingId      String
  authorId       String?
  targetId       String
  authorRole     ReviewAuthorRole
  clientReviewId String?
  rating         Int
  text           String?          @db.VarChar(1000)
  publishAt      DateTime
  hiddenAt       DateTime?
  hiddenById     String?
  hiddenReason   String?
  createdAt      DateTime         @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  author   User?   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  target   User    @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Restrict)
  hiddenBy User?   @relation("ReviewModerator", fields: [hiddenById], references: [id], onDelete: SetNull)

  @@unique([bookingId, authorRole])
  @@unique([authorId, clientReviewId])
  @@index([targetId, publishAt, createdAt, id])
  @@index([bookingId, createdAt])
  @@index([authorId])
  @@index([hiddenById])
  @@map("reviews")
}

model BookingTransitionHistory {
  id        String         @id @default(uuid())
  bookingId String
  actorId   String?
  actorType String
  command   String
  oldStatus BookingStatus?
  newStatus BookingStatus
  reason    String?
  requestId String
  createdAt DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([actorId])
  @@index([requestId])
  @@map("booking_transition_history")
}

model BookingAct {
  id            String          @id @default(uuid())
  bookingId     String
  authorId      String
  stage         BookingActStage
  createdAt     DateTime        @default(now())
  confirmedById String?
  confirmedAt   DateTime?
  readinessIsWorking      Boolean?
  readinessIsComplete     Boolean?
  readinessVisibleDefects String?
  readinessDeclaredAt     DateTime?

  booking     Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author      User              @relation("BookingActAuthor", fields: [authorId], references: [id])
  confirmedBy User?             @relation("BookingActConfirmer", fields: [confirmedById], references: [id])
  evidence    BookingEvidence[]

  @@unique([bookingId, stage])
  @@index([authorId])
  @@index([confirmedById])
  @@map("booking_acts")
}

model BookingEvidence {
  id             String   @id @default(uuid())
  actId          String
  uploadIntentId String   @unique
  storageKey     String
  sha256         String
  createdAt      DateTime @default(now())

  act          BookingAct   @relation(fields: [actId], references: [id], onDelete: Cascade)
  uploadIntent UploadIntent @relation(fields: [uploadIntentId], references: [id])

  @@index([actId])
  @@map("booking_evidence")
}

model NotificationOutboxEvent {
  id               String    @id @default(uuid())
  bookingId        String?
  supportTicketId  String?
  recipientId      String?
  itemId           String?
  eventType        String
  deduplicationKey String    @unique
  createdAt        DateTime  @default(now())
  processedAt      DateTime?

  booking        Booking?       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  supportTicket  SupportTicket? @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  recipient      User?          @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  item           Item?          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inboxEvents    InboxEvent[]
  pushDeliveries PushDelivery[]

  @@index([processedAt, createdAt])
  @@index([bookingId])
  @@index([supportTicketId])
  @@index([recipientId])
  @@index([itemId])
  @@map("notification_outbox_events")
}

model InboxEvent {
  id              String    @id @default(uuid())
  eventId         String
  recipientId     String
  bookingId       String?
  supportTicketId String?
  itemId          String?
  eventType       String
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  outboxEvent   NotificationOutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipient     User                    @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  booking       Booking?                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  supportTicket SupportTicket?          @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  item          Item?                   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([eventId, recipientId])
  @@index([recipientId, createdAt])
  @@index([bookingId])
  @@index([supportTicketId])
  @@index([itemId])
  @@map("inbox_events")
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  userId            String
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  yookassaPaymentId String?       @unique
  checkoutUrl       String?
  rawPayload        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model KycDocument {
  id            String          @id @default(uuid())
  userId        String
  type          KycDocumentType
  storageKey    String
  status        KycStatus       @default(PENDING)
  reviewComment String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user       User  @relation("KycDocumentUser", fields: [userId], references: [id])
  reviewedBy User? @relation("KycDocumentReviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
  @@index([reviewedById])
  @@map("kyc_documents")
}

model SupportTicket {
  id                 String              @id @default(uuid())
  userId             String
  bookingId          String?
  bookingIssueReason BookingIssueReason?
  type               SupportTicketType   @default(GENERAL)
  subject            String
  message            String
  status             SupportTicketStatus @default(OPEN)
  adminResponse      String?
  assigneeId         String?
  respondedById      String?
  respondedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user         User                      @relation("SupportTicketUser", fields: [userId], references: [id])
  booking      Booking?                  @relation(fields: [bookingId], references: [id])
  assignee     User?                     @relation("SupportTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  respondedBy  User?                     @relation("SupportTicketResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  messages     SupportMessage[]
  outboxEvents NotificationOutboxEvent[]
  inboxEvents  InboxEvent[]

  @@index([userId])
  @@index([bookingId])
  @@index([bookingIssueReason])
  @@index([assigneeId])
  @@index([respondedById])
  @@index([status])
  @@index([type])
  @@map("support_tickets")
}

model SupportMessage {
  id         String                   @id @default(uuid())
  ticketId   String
  authorId   String
  authorRole SupportMessageAuthorRole
  body       String
  createdAt  DateTime                 @default(now())

  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User                @relation(fields: [authorId], references: [id])
  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("support_messages")
}

model SupportAttachment {
  id             String   @id @default(uuid())
  messageId      String
  uploadIntentId String   @unique
  storageKey     String
  sha256         String
  createdAt      DateTime @default(now())

  message      SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadIntent UploadIntent   @relation(fields: [uploadIntentId], references: [id])

  @@index([messageId])
  @@map("support_attachments")
}

model UserReport {
  id           String           @id @default(uuid())
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  reason       ReportReason
  description  String
  status       ReportStatus     @default(OPEN)
  reviewedById String?
  reviewedAt   DateTime?
  decision     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id])
  reviewedBy User? @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([reporterId, createdAt])
  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@index([reviewedById])
  @@map("user_reports")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model DevicePushToken {
  id             String            @id @default(uuid())
  userId         String
  installationId String
  provider       PushTokenProvider
  platform       PushPlatform
  token          String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]

  @@unique([provider, token])
  @@unique([userId, installationId, provider])
  @@index([userId])
  @@map("device_push_tokens")
}

model PushDelivery {
  id              String             @id @default(uuid())
  eventId         String
  tokenId         String
  status          PushDeliveryStatus @default(PENDING)
  attempts        Int                @default(0)
  nextAttemptAt   DateTime           @default(now())
  processingUntil DateTime?
  deliveredAt     DateTime?
  lastErrorCode   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  event NotificationOutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  token DevicePushToken         @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([eventId, tokenId])
  @@index([status, nextAttemptAt])
  @@index([processingUntil])
  @@map("push_deliveries")
}

model AdminAuditLog {
  id         String           @id @default(uuid())
  adminId    String?
  action     String
  entityType String?
  entityId   String?
  capability AdminCapability?
  reason     String?
  requestId  String?
  deviceId   String?
  before     Json?
  after      Json?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime         @default(now())

  admin User? @relation("AdminAuditLogAdmin", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}
