PORT=3000
# Comma-separated exact reverse proxy IP/CIDR values. Empty means trust none.
TRUSTED_PROXY_IPS=""
# Exact browser origins, without paths or trailing slash. Required in production.
CORS_ALLOWED_ORIGINS="http://localhost:5173"
# API accepts small JSON/form metadata only; binary uploads go directly to S3.
HTTP_BODY_LIMIT="256kb"
HTTP_REQUEST_TIMEOUT_MS="30000"
HTTP_HEADERS_TIMEOUT_MS="15000"
HTTP_KEEP_ALIVE_TIMEOUT_MS="5000"
# Bearer token for /api/v1/internal/metrics; minimum 32 characters in production.
METRICS_TOKEN="replace_with_at_least_32_random_characters"
# Raise only when an older mobile contract is genuinely incompatible.
MIN_SUPPORTED_MOBILE_VERSION="1.0.0"
# HTTPS store URLs returned only to an outdated client for its platform.
ANDROID_UPDATE_URL=""
IOS_UPDATE_URL=""

# Keep empty until marketplace legal/safety documents are approved and public.
# Draft versions are rejected; without both values POST /bookings returns 503.
MARKETPLACE_OFFER_VERSION=""
MARKETPLACE_CANCELLATION_POLICY_VERSION=""

# Production backup job only. Values belong in the production secret manager.
BACKUP_ENCRYPTION_KEY_BASE64=""
BACKUP_PRIMARY_S3_ENDPOINT=""
BACKUP_PRIMARY_S3_REGION=""
BACKUP_PRIMARY_S3_BUCKET=""
BACKUP_PRIMARY_S3_ACCESS_KEY_ID=""
BACKUP_PRIMARY_S3_SECRET_ACCESS_KEY=""
BACKUP_SECONDARY_S3_ENDPOINT=""
BACKUP_SECONDARY_S3_REGION=""
BACKUP_SECONDARY_S3_BUCKET=""
BACKUP_SECONDARY_S3_ACCESS_KEY_ID=""
BACKUP_SECONDARY_S3_SECRET_ACCESS_KEY=""
# Existing node-exporter textfile collector directory; job updates atomically.
BACKUP_METRICS_FILE="/var/lib/node_exporter/textfile_collector/sosedi_backup.prom"

DATABASE_URL="postgresql://sosedi:sosedi@localhost:5434/sosedi?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
ADMIN_MFA_ENCRYPTION_KEY="replace_with_32_random_bytes_encoded_as_base64"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
ADMIN_SESSION_EXPIRES_IN="5m"

SMS_PROVIDER="smsru"
SMS_API_KEY="change_me"
# Server-side secret for authenticated address suggestions. Leave empty to
# keep manual address entry available without calling DaData.
# Local development only; ignored when NODE_ENV=production.
DEV_SMS_OTP_CODE="123456"
OTP_DEVICE_RATE_LIMIT="6"
OTP_IP_RATE_LIMIT="60"
OTP_GLOBAL_RATE_LIMIT="1000"

# Keep disabled until an active FCM or RuStore adapter is configured.
PUSH_DELIVERY_ENABLED="false"

S3_ENDPOINT="https://s3.example.ru"
S3_REGION="ru-1"
S3_BUCKET_PUBLIC="sosedi-public"
S3_PUBLIC_BASE_URL="https://cdn.example.ru"
S3_BUCKET_PRIVATE="sosedi-kyc-private"
S3_ACCESS_KEY="change_me"
S3_SECRET_KEY="change_me"

YOOKASSA_SHOP_ID="change_me"
YOOKASSA_SECRET_KEY="change_me"
YOOKASSA_WEBHOOK_SECRET="change_me"

PAYMENT_SCENARIO="FAKE_SAFE_DEAL"
FAKE_SAFE_DEAL_DEPOSIT_MAX_MINOR="10000000"
FAKE_SAFE_DEAL_POLICY_VERSION="fake-deposit-2026-09-02"
FAKE_SAFE_DEAL_DISPUTE_WINDOW_SECONDS="300"
