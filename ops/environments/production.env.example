DEPLOYMENT_ENVIRONMENT="production"
MAX_CLOCK_SKEW_MS="5000"
PROVIDER_MODE="live"
NONPRODUCTION_DATA_POLICY="production"
DATABASE_URL="postgresql://sosedi_production:replace_me@production.db.internal:5432/sosedi_production"
REDIS_URL="redis://sosedi_runtime:replace_me@production.redis.internal:6379/0"
JWT_ACCESS_SECRET="replace_me_production_access"
JWT_REFRESH_SECRET="replace_me_production_refresh"
ADMIN_MFA_ENCRYPTION_KEY="replace_me_production_mfa"
METRICS_TOKEN="replace_me_production_metrics"
S3_ENDPOINT="https://s3.provider.ru"
S3_BUCKET_PUBLIC="sosedi-production-public"
S3_BUCKET_PRIVATE="sosedi-production-private"
S3_ACCESS_KEY="replace_me_production_s3_identity"
SMS_PROVIDER="smsru"
SMS_PROVIDER_MODE="live"
OTP_GLOBAL_RATE_LIMIT="1000"
PAYMENT_SCENARIO="PAY_ON_HANDOVER"
PUSH_PROVIDER_MODE="disabled"
